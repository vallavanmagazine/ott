# Vallavan backend (NestJS) — server-side secrets. NEVER commit the real .env.
# These may also be set from the admin "API Settings" page (platform_settings);
# SettingsService reads DB first, then falls back to these env vars.

PORT=3001
CORS_ORIGIN=http://localhost:5173

# Supabase (service role bypasses RLS — server only, never shipped to client)
SUPABASE_URL=https://ipybmgkorxidxuqlptgj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
DIRECT_URL=

# Payments — Razorpay TEST keys only (no live charges)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=

# AI (AI Studio ad-creative generation)
