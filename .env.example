# Vallavan frontend (Vite) — PUBLIC values only (these ship in the client bundle).
# Never put secret keys here (Anthropic, Razorpay SECRET, Resend, etc.) — those
# live in backend/.env and the admin "API Settings" page (platform_settings).

VITE_SUPABASE_URL=https://ipybmgkorxidxuqlptgj.supabase.co
VITE_SUPABASE_ANON_KEY=

# NestJS backend base URL (AI Studio, server-verified wallet). Optional in dev.
VITE_API_BASE_URL=http://localhost:3001

# Razorpay TEST key id — public by design (the secret stays server-side).
# Enables the BillingScreen frontend-direct top-up (test mode only).
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
