# Production values for the SSR public layer. Both are PUBLIC (NEXT_PUBLIC_*)
# and safe to ship in the client bundle — no secret belongs in this file.
#
# Domain split: seo-site owns the root domain, the SPA moves to app.
# Matches project/nginx/vallavan.conf.
NEXT_PUBLIC_SITE_URL=https://vallavan.in
NEXT_PUBLIC_APP_URL=https://app.vallavan.in

# The anon key must be present at BUILD time, not just at runtime: Next inlines
# NEXT_PUBLIC_* values into the output, and lib/supabase.ts falls back to
# 'placeholder-anon-key' rather than failing — so a blank value here builds
# "successfully" but bakes an empty sitemap and an empty homepage.
#
# role=anon, ref=ipybmgkorxidxuqlptgj. Public by design and already served in
# the SPA's JS bundle; access is gated by RLS, not by hiding this value.
NEXT_PUBLIC_SUPABASE_URL=https://ipybmgkorxidxuqlptgj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlweWJtZ2tvcnhpZHh1cWxwdGdqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY0OTg3NjAsImV4cCI6MjEwMjA3NDc2MH0.sg2781NXAFda5Ca_hQDVjTjy7ErrS9KJYgZicmeTDM4
